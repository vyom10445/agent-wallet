# Copy to .env and fill in. .env is git-ignored: never commit it.
# Testnet only. Never put a real wallet's private key or seed phrase anywhere in this project.
# The deployer/owner key is NOT stored here: import it once with `cast wallet import deployer --interactive`.

BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# Free key from https://etherscan.io/myapikey (Etherscan API V2 covers Base Sepolia). Only needed for verification.
ETHERSCAN_API_KEY=

# Agent (session key). Create a brand-new throwaway key with `cast wallet new`; it never needs ETH.
AGENT_ADDRESS=
AGENT_PRIVATE_KEY=

# Optional policy overrides (mUSDC has 6 decimals: 1_000_000 = 1 mUSDC)
# AGENT_MAX_PER_TX=1000000
# AGENT_DAILY_LIMIT=5000000
# AGENT_VALID_DAYS=7
# MERCHANT_ALLOWANCE=10000000
# MINT_AMOUNT=100000000
# GAS_DEPOSIT_WEI=5000000000000000
# SMOKE_CREDITS=10
