# Copy to .env and fill in on your own PC. .env is git-ignored: never commit it or paste it anywhere.
# Testnet throwaway keys only. The backend NEVER holds the owner key.

# 84532 = Base Sepolia (default), 31337 = local Anvil
CHAIN_ID=84532
# Required. Use your own endpoint if the public one rate-limits you.
RPC_URL=https://sepolia.base.org

# Agent session key (must equal the agent registered on the wallet). Needs no ETH.
AGENT_ADDRESS=0xC74Ba823524Cbd1d889b5FD38785b9d293C6D8aD
AGENT_PRIVATE_KEY=
# Funded Base Sepolia EOA that calls EntryPoint.handleOps. Use a separate throwaway key, not the owner/deployer.
SUBMITTER_PRIVATE_KEY=

# LLM (Phase 7). none = no LLM, deterministic "buy N credits" planner (free, works offline).
# anthropic | openai-compatible (OpenAI, Gemini, Ollama). See README "Choosing an LLM".
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_TIMEOUT_MS=30000
# How long an over-limit request waits for the owner before it expires (seconds, 60 to 2592000)
APPROVAL_TTL_SECONDS=86400

# SQLite file, relative to backend/
DB_PATH=data/agent.sqlite
PORT=8787

# Event indexer (GET /events). Empty = defaults.
# First block to index on a new database. Default: the block of contracts/broadcast/Deploy.s.sol/<chain>/run-latest.json.
EVENTS_START_BLOCK=
# Blocks per eth_getLogs call (halved automatically if the RPC refuses the range)
EVENTS_CHUNK_SIZE=5000
# Poll interval in ms (0 = no background polling)
EVENTS_POLL_MS=4000
# Only index blocks this deep (default 2 on Base Sepolia, 0 on Anvil)
EVENTS_CONFIRMATIONS=
