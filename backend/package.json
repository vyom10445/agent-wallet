{
  "name": "agent-wallet-backend",
  "private": true,
  "type": "module",
  "description": "P-2 AI agent backend for the AgentWallet contracts (Node 22, viem, node:sqlite).",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "check": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env scripts/check-setup.mjs",
    "status": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env scripts/status.mjs",
    "test": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env --test --test-concurrency=1",
    "test:anvil": "node --test --test-concurrency=1 test/config.test.mjs test/userop.test.mjs test/reads.anvil.test.mjs test/userop.anvil.test.mjs",
    "test:sepolia": "node --env-file-if-exists=.env --test test/reads.base-sepolia.test.mjs"
  },
  "dependencies": {
    "viem": "2.57.11"
  }
}
